---
import BaseLayout from '../../layouts/BaseLayout.astro';
import software from '../../data/software';

const sortedSoftware = [...software].sort((a, b) => a.order - b.order);
const categories = [...new Set(software.map((s) => s.category))];
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Software Index — NJAC"
  description="Complete collection of NJAC desktop applications. Each project exists to solve one problem, properly."
>
  <div class="container">
    <section class="software-section">
      <div class="section-header">
        <h2>Software<br />Index</h2>
        <p>Complete collection of desktop applications. Each project exists to solve one problem, properly.</p>
      </div>

      <div class="filter-bar">
        <button class="filter-btn active" data-filter="all">All</button>
        {
          categories.map((cat) => (
            <button class="filter-btn" data-filter={cat}>
              {cat.charAt(0).toUpperCase() + cat.slice(1)}
            </button>
          ))
        }
      </div>

      <div class="software-list">
        {
          sortedSoftware.map((s, i) => (
            <a
              class="software-item reveal"
              data-category={s.category}
              href={`${base}software/${s.id}/`}
            >
              <span class="software-number">{String(i + 1).padStart(3, '0')}</span>
              <div class="software-info">
                <h3>{s.title}</h3>
                <p>{s.tagline}</p>
              </div>
              <span class="software-category">{s.category}</span>
              <span class="software-version">v{s.version}</span>
              <span class="software-arrow">→</span>
            </a>
          ))
        }
      </div>
    </section>
  </div>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const items = document.querySelectorAll<HTMLElement>('.software-item');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const filter = btn.dataset.filter;
        items.forEach((item) => {
          item.classList.toggle('hidden', filter !== 'all' && item.dataset.category !== filter);
        });
      });
    });
  </script>
</BaseLayout>