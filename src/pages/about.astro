---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About — NJAC"
  description="Nothing Just A Code is a philosophy. Every application exists to solve a specific problem with precision."
>
  <div class="container">
    <section class="about-section">
      <div class="section-header">
        <h2>About<br />NJAC</h2>
        <p>Nothing Just A Code is a philosophy. Every application exists to solve a specific problem with precision.</p>
      </div>

      <div class="about-grid">
        <div class="about-text">
          <p class="reveal">We build software that combines technical excellence with thoughtful design. Tools that people actually want to use.</p>
          <p class="reveal">Every project starts with a problem worth solving. We don't build for trends. We build for utility, reliability, and longevity.</p>
          <p class="reveal">Quality over quantity. Always.</p>
        </div>
        <div>
          <h3 class="principles-title">Principles</h3>
          <div class="principle reveal">
            <strong>Free Forever</strong>
            <p>Every application is free to download and use</p>
          </div>
          <div class="principle reveal">
            <strong>Quality First</strong>
            <p>No compromise on standards</p>
          </div>
          <div class="principle reveal">
            <strong>Human Design</strong>
            <p>Built for people, not machines</p>
          </div>
          <div class="principle reveal">
            <strong>Continuous Improvement</strong>
            <p>Every release is better than the last</p>
          </div>
        </div>
      </div>

      <h3 class="journey-title">Journey</h3>
      <div class="timeline">
        <div class="timeline-item reveal">
          <div class="timeline-year">2024</div>
          <h4>The Beginning</h4>
          <p>Started with a simple idea: build software that matters</p>
        </div>
        <div class="timeline-item reveal">
          <div class="timeline-year">2026</div>
          <h4>Nexus Forge</h4>
          <p>Released our first application which supports our own extension to the public. First downloads, first feedback, first real users.</p>
        </div>
        <div class="timeline-item reveal">
          <div class="timeline-year">Present</div>
          <h4>What's Next</h4>
          <p>More applications in development. Every one of them free, every one of them built to last.</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>